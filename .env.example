# Random secret to prevent unauthorized cache invalidation calls
CACHE_INVALIDATION_SECRET=change-me-in-production

# Vendure Shop API endpoint URL
PUBLIC_VENDURE_SHOP_API=http://localhost:3000/shop-api

# Optional Vendure channel token. Sent as the `vendure-token` header on every Shop API request.
# PUBLIC_VENDURE_CHANNEL_TOKEN=your-channel-token

# Optional default locale code (defaults to `en` if not set)
PUBLIC_DEFAULT_LOCALE=en

# Optional comma-separated list of enabled locale codes (defaults to `en` if not set)
PUBLIC_ENABLED_LOCALES=en,nl,de
