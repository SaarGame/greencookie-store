---
import "../styles/global.css";
import { Notification } from "../components/Notification";
import { CartModal } from "../components/CartModal";


interface Props {
  title: string;
  metaTitle: string;
  metaDescription: string;
}

const { title, metaTitle, metaDescription } = Astro.props;
---

<html lang={Astro.locals.locale} data-locale={Astro.locals.locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="title" content={metaTitle} />
    <meta name="description" content={metaDescription} />
  </head>
  <body class="bg-base-200 flex min-h-screen flex-col">
    <slot />
    <CartModal client:only="react" />
    <Notification client:only="react" />
  </body>
</html>

<!-- Pass current locale to the client -->
<script
  define:vars={{
    locale: Astro.locals.locale,
  }}
  is:inline
>
  window.__locale = locale;
</script>

<script>
  import { getActiveOrder } from "../lib/client/order-service";
  // Fetch active order client-side on every page load
  getActiveOrder(window.__locale).catch(console.error);
</script>
