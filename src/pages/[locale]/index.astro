---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navigation from "../../components/Navigation.astro";
import Hero from "../../components/Hero.astro";
import { ProductCard } from "../../components/ProductCard";
import CollectionCard from "../../components/CollectionCard.astro";
import Footer from "../../components/Footer.astro";
import { vendureClient } from "../../lib/util/vendure-client";
import { NavigationCollectionsQuery } from "../../lib/server/collection-queries";
import { PopularProductsQuery } from "../../lib/server/product-queries";
import ContentLayout from "../../layouts/ContentLayout.astro";
import { getLowestPriceVariant } from "../../lib/util/product-util";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";

export const prerender = false;

const client = vendureClient(Astro.locals.locale);
const [
  {
    collections: { items: collections },
  },
  {
    products: { items: products },
  },
] = await Promise.all([
  client.request(NavigationCollectionsQuery),
  client.request(PopularProductsQuery, { limit: 4 }),
]);

Astro.cache.set({
  maxAge: 43200,
  swr: 3600,
  tags: ["home", "product", "collection"],
});
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, must-revalidate",
);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title={t("home.meta.title")}
  metaTitle={t("home.meta.title")}
  metaDescription={t("home.meta.description")}
>
  <Navigation collections={collections} />

  <Hero
    image="https://images.unsplash.com/photo-1665937832097-832d1e08cf3f?q=80&w=1472&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D"
    title={t("home.hero.title")}
    description={t("home.hero.description")}
    buttonText={t("home.hero.buttonText")}
    buttonHref="#"
  />

  <ContentLayout>
    <main>
      <!-- Product section -->
      <section aria-labelledby="product-heading">
        <h2 id="category-heading" class="text-2xl font-bold tracking-tight">
          {t("home.popularProducts")}
        </h2>

        <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-8">
          {
            products.map((product) => (
              <ProductCard
                client:load
                locale={Astro.locals.locale}
                slug={product.slug}
                image={product.featuredAsset?.preview ?? ""}
                title={product.name}
                price={
                  getLowestPriceVariant(product.variants)?.priceWithTax ?? 0
                }
                variants={product.variants}
              />
            ))
          }
        </div>
      </section>
      <!-- Collection section -->
      <section aria-labelledby="collection-heading" class="mt-20">
        <h2 id="collection-heading" class="text-2xl font-bold tracking-tight">
          {t("home.shopByCollection")}
        </h2>
        <p class="mt-4 text-base opacity-70"></p>

        <div class="mt-10 grid gap-4 lg:grid-cols-3 lg:gap-8">
          {
            collections.map((collection) => (
              <CollectionCard
                href={`/${Astro.locals.locale}/c/${collection.slug}`}
                image={`${collection.featuredAsset?.preview}`}
                title={collection.name}
              />
            ))
          }
        </div>
      </section>
      <section aria-labelledby="faction-heading" class="mt-20">
        <h2 id="faction-heading" class="text-2xl font-bold tracking-tight">
          {t("home.shopByFaction")}
        </h2>
        <p class="mt-4 text-base opacity-70"></p>

        <div class="mt-10 grid gap-4 lg:grid-cols-3 lg:gap-8">
          {
            (
              collections.find(
                (c) =>
                  c.slug === "wargaming-models" ||
                  c.name === "Wargaming Models",
              )?.children ?? []
            ).map((subcollection) => (
              <CollectionCard
                href={`/${Astro.locals.locale}/c/${subcollection.slug}`}
                image={`${subcollection.featuredAsset?.preview}`}
                title={subcollection.name}
              />
            ))
          }
        </div>
      </section>
    </main>
  </ContentLayout>

  <Footer />
</BaseLayout>
