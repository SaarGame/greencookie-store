---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navigation from "../../../components/Navigation.astro";
import { ProductCard } from "../../../components/ProductCard";
import CollectionCard from "../../../components/CollectionCard.astro";
import Footer from "../../../components/Footer.astro";
import ContentLayout from "../../../layouts/ContentLayout.astro";
import { getCollectionDetail } from "../../../lib/server/collection-service";
import {
  groupVariantsByProduct,
  getLowestPriceVariant,
} from "../../../lib/util/product-util";

const { collection: slug } = Astro.params;

if (!slug) {
  return Astro.redirect("/404");
}

const collection = await getCollectionDetail(Astro.locals.locale, slug);

if (!collection) {
  return Astro.redirect("/404");
}

Astro.cache.set({
  maxAge: 43200,
  swr: 3600,
  tags: ["collection", `collection:${slug}`],
});

const products = groupVariantsByProduct(collection.productVariants.items);
const subcollections = collection.children ?? [];
---

<BaseLayout
  title={collection.name}
  metaTitle={collection.name}
  metaDescription={collection.description}
>
  <Navigation />

  <ContentLayout>
    <main>
      <div class="mb-8">
        <h1 class="text-3xl font-bold">{collection.name}</h1>
        <div class="mt-2 opacity-70" set:html={collection.description} />
      </div>

      {
        subcollections.length > 0 && (
          <section aria-labelledby="subcollection-heading" class="mb-16">
            <h2
              id="subcollection-heading"
              class="text-2xl font-bold tracking-tight"
            >
              {Astro.locals.m.collection_subcollections()}
            </h2>

            <div class="mt-10 grid gap-4 lg:grid-cols-2 lg:gap-8">
              {subcollections.map((subcollection) => (
                <CollectionCard
                  href={`/${Astro.locals.locale}/c/${subcollection.slug}`}
                  image={subcollection.featuredAsset?.preview ?? ""}
                  title={subcollection.name}
                  description={subcollection.description || ""}
                />
              ))}
            </div>
          </section>
        )
      }

      {
        products.length > 0 && (
          <section aria-labelledby="products-heading">
            <h2 id="products-heading" class="text-2xl font-bold tracking-tight">
              {Astro.locals.m.collection_products()}
            </h2>

            <div class="mt-10 grid grid-cols-2 gap-4 lg:grid-cols-4 lg:gap-8">
              {products.map((product) => (
                <ProductCard
                  client:load
                  slug={product.slug}
                  image={product.featuredAsset?.preview ?? ""}
                  title={product.name}
                  price={
                    getLowestPriceVariant(product.variants)?.priceWithTax ?? 0
                  }
                  variants={product.variants}
                />
              ))}
            </div>
          </section>
        )
      }
    </main>
  </ContentLayout>

  <Footer />
</BaseLayout>
