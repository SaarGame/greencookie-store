---
import Breadcrumb from "../../../components/Breadcrumb.astro";
import Footer from "../../../components/Footer.astro";
import Navigation from "../../../components/Navigation.astro";
import { ProductImageGallery } from "../../../components/ProductImageGallery";
import { ProductSelector } from "../../../components/ProductSelector";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { vendureClient } from "../../../lib/util/vendure-client";
import { NavigationCollectionsQuery } from "../../../lib/server/collection-queries";
import { ProductBySlugQuery } from "../../../lib/server/product-queries";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

export const prerender = false;

const client = vendureClient(Astro.locals.locale);
const [
  { product },
  {
    collections: { items: navCollections },
  },
] = await Promise.all([
  client.request(ProductBySlugQuery, { slug: Astro.params.product! }),
  client.request(NavigationCollectionsQuery),
]);
if (!product) {
  return Astro.redirect(`/404`);
}

Astro.cache.set({
  maxAge: 43200,
  swr: 3600,
  tags: ["product", `product:${Astro.params.product}`],
});
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=0, must-revalidate",
);

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title={product.name}
  metaTitle="Product"
  metaDescription="Product detail"
>
  <Navigation collections={navCollections} />

  <main>
    <Breadcrumb
      paths={product.collections[0]?.breadcrumbs ?? []}
      currentPage={product.name}
    />

    <div
      class="mx-auto max-w-2xl px-4 pb-16 sm:px-6 sm:pb-24 lg:max-w-7xl lg:px-8"
    >
      <div class="lg:grid lg:grid-cols-2 lg:items-start lg:gap-x-8">
        <h1
          class="text-base-content mb-4 text-3xl font-bold tracking-tight sm:hidden"
        >
          {product.name}
        </h1>
        <!-- Image gallery -->
        <ProductImageGallery client:load product={product} />

        <!-- Product info -->
        <div class="mt-10 px-4 sm:mt-16 sm:px-0 lg:mt-0">
          <h1
            class="text-base-content mb-3 hidden text-3xl font-bold tracking-tight sm:block"
          >
            {product.name}
          </h1>

          <h2 class="sr-only">Product information</h2>
          <ProductSelector
            client:load
            product={product}
            addToCartLabel={t("pdp.addToCart")}
            soldOutLabel={t("pdp.soldOut")}
            moreLabel={t("actions.more")}
          />

          <div class="mt-6">
            <h3 class="sr-only">Description</h3>
            <div class="text-base-content/80 space-y-6 text-base">
              <div set:html={product.description} />
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
