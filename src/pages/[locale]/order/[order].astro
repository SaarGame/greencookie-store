---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Navigation from "../../../components/Navigation.astro";
import Footer from "../../../components/Footer.astro";
import { OrderConfirmation } from "../../../components/OrderConfirmation";

const { order } = Astro.params;
---

<BaseLayout
  title="Order Confirmation"
  metaTitle="Order Confirmation"
  metaDescription="Order Confirmation"
>
  <Navigation />
  <main>
    <div
      class="mx-auto max-w-2xl px-4 pt-16 pb-24 sm:px-6 lg:max-w-7xl lg:px-8"
    >
      <OrderConfirmation client:only="react" code={order!} />
    </div>
  </main>
  <Footer />
</BaseLayout>
