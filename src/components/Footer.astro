---
import { vendureClient } from "../lib/util/vendure-client";
import { NavigationCollectionsQuery } from "../lib/server/collection-queries";

const locale = Astro.locals.locale;
const { collections: { items: collections } } = await vendureClient(locale).request(NavigationCollectionsQuery);
const base = `/${locale}`;
---

<footer class="bg-neutral text-neutral-content mt-auto">
  <div
    class="footer md:footer-horizontal mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-10 p-10 md:grid-cols-4"
  >
    {
      collections.map((collection) => (
        <nav>
          <h6 class="footer-title">
            <a href={`${base}/c/${collection.slug}`} class="link link-hover">
              {collection.name}
            </a>
          </h6>
          {collection.children?.map((child) => (
            <a href={`${base}/c/${child.slug}`} class="link link-hover">
              {child.name}
            </a>
          ))}
        </nav>
      ))
    }

  </div>
  <div class="border-neutral-content/20 border-t px-4 py-10">
    <p class="text-neutral-content/60 text-center text-sm">
      Made with <span class="text-green-500">💚</span> by <a
        href="https://pinelab.studio"
        class="link link-hover">Pinelab.studio</a
      >
    </p>
  </div>
</footer>
